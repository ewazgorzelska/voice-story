---
interface NavBarProps {
  currentPath: string;
}

const { currentPath } = Astro.props as NavBarProps;

const links = [
  { href: "/stories", label: "Story Library" },
  { href: "/my-library", label: "My Library" },
  { href: "/voice-sample", label: "Voice Sample" },
];

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
};

const linkClasses = (href: string) =>
  [
    "inline-flex items-center rounded-md px-3 py-2 text-sm font-medium transition-colors",
    isActive(href)
      ? "bg-primary/10 text-primary shadow-sm"
      : "text-muted-foreground hover:text-foreground hover:bg-muted/60",
  ].join(" ");
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <nav class="container mx-auto flex items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="text-base font-semibold tracking-tight text-foreground"> Voice Story </a>
    <div class="flex items-center gap-2 sm:gap-4">
      {
        links.map((link) => (
          <a href={link.href} class={linkClasses(link.href)} aria-current={isActive(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
