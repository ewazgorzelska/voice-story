---
import LogoutButton from "@/components/auth/LogoutButton";
import { BookOpen, Sparkles } from "lucide-react";

interface NavBarProps {
  currentPath: string;
  user?: {
    id: string;
    email: string | null;
  } | null;
}

const { currentPath, user = null } = Astro.props as NavBarProps;

const links = [
  { href: "/stories", label: "Story Library" },
  { href: "/my-library", label: "My Library" },
  { href: "/voice-sample", label: "Voice Sample" },
];

const isActive = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
};

const linkClasses = (href: string) =>
  [
    "inline-flex items-center rounded-md px-2 sm:px-2 py-1.5 sm:py-1 text-sm font-medium transition-colors",
    isActive(href)
      ? "bg-primary/10 text-primary shadow-sm"
      : "text-muted-foreground hover:text-foreground hover:bg-muted/60",
  ].join(" ");

const isAuthenticated = Boolean(user);
const userEmail = user?.email ?? null;
---

<header
  class="sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
  <nav class="container mx-auto flex items-center justify-between gap-2 sm:gap-4 px-2 sm:px-4 py-2 sm:py-3">
    <div class="px-2 sm:px-4 py-2 sm:py-4">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-lg sm:text-xl font-semibold tracking-tight text-foreground hover:text-primary transition-colors group"
      >
        <div class="relative">
          <BookOpen className="size-5 sm:size-6 text-primary" />
          <Sparkles
            className="absolute -top-2 -right-2 size-3 sm:size-3.5 text-primary/70 group-hover:text-primary transition-colors"
          />
        </div>
        <span class="sm:inline hidden">Voice Story</span>
      </a>
    </div>
    <div class="flex items-center gap-2 sm:gap-5">
      <div class="flex items-center gap-1 sm:gap-4">
        {
          links.map((link) => (
            <a href={link.href} class={linkClasses(link.href)} aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="flex items-center gap-2 sm:gap-3 whitespace-nowrap">
        {
          isAuthenticated ? (
            <>
              {userEmail ? (
                <span class="hidden text-sm text-muted-foreground md:inline">
                  Signed in as <span class="font-medium text-foreground">{userEmail}</span>
                </span>
              ) : null}
              <LogoutButton client:idle />
            </>
          ) : (
            <>
              <a href="/login" class={linkClasses("/login")} aria-current={isActive("/login") ? "page" : undefined}>
                Sign in
              </a>
              <a
                href="/register"
                class={linkClasses("/register")}
                aria-current={isActive("/register") ? "page" : undefined}
              >
                Sign up
              </a>
            </>
          )
        }
      </div>
    </div>
  </nav>
</header>
