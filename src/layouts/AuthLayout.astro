---
import "../styles/global.css";
import { BookOpen, Sparkles } from "lucide-react";

interface Props {
  title?: string;
}

const { title = "Voice Story" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border/60 bg-background">
        <div class="container mx-auto px-4 py-3 sm:py-4">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-lg sm:text-xl font-semibold tracking-tight text-foreground hover:text-primary transition-colors group"
          >
            <div class="relative">
              <BookOpen className="size-5 sm:size-6 text-primary" />
              <Sparkles
                className="absolute -top-2 -right-2 size-3 sm:size-3.5 text-primary/70 group-hover:text-primary transition-colors"
              />
            </div>
            <span>Voice Story</span>
          </a>
        </div>
      </header>
      <main class="flex flex-1 items-start sm:items-center justify-center px-4 py-6 sm:py-8 md:py-12">
        <slot />
      </main>
      <footer class="mt-auto border-t border-border/60 bg-background">
        <div class="container mx-auto px-4 py-3 sm:py-4 text-center text-xs sm:text-sm text-muted-foreground">
          <a href="/terms" class="hover:text-foreground transition-colors">Terms of Service</a>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
