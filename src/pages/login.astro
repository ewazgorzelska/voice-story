---
import AuthLayout from "@/layouts/AuthLayout.astro";
import LoginForm from "@/components/auth/LoginForm";

// Authenticated users are redirected server-side based on their voice sample status.

export const prerender = false;

const { user, supabase } = Astro.locals;

if (user && supabase) {
  const { data: voiceSample, error: voiceSampleError } = await supabase
    .from("voice_samples")
    .select("id")
    .eq("user_id", user.id)
    .maybeSingle();

  if (voiceSampleError) {
    // eslint-disable-next-line no-console
    console.error("Failed to determine voice sample status for redirect", voiceSampleError);
    return Astro.redirect("/stories");
  }

  if (voiceSample) {
    return Astro.redirect("/stories");
  }

  return Astro.redirect("/voice-sample");
}
---

<AuthLayout title="Sign In - Voice Story">
  <div class="w-full max-w-md">
    <LoginForm client:load />
  </div>
</AuthLayout>
