---
import AuthLayout from "@/layouts/AuthLayout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";

export const prerender = false;

const { supabase } = Astro.locals;

// Extract parameters from URL - Supabase sends "code" for PKCE flow
const url = new URL(Astro.request.url);
const code = url.searchParams.get("code");

let tokenExchangeError = false;
let errorMessage = "";

// If we have a code, exchange it for a session (PKCE flow)
if (code && supabase) {
  const { error } = await supabase.auth.exchangeCodeForSession(code);

  if (error) {
    // eslint-disable-next-line no-console
    console.error("Failed to exchange code for session:", error);
    tokenExchangeError = true;
    errorMessage = error.message || "Failed to verify reset link";
  }
}

// Check if user is now authenticated after code exchange
const {
  data: { user },
} = await supabase.auth.getUser();

// Show reset form if we have a user (either from code exchange or existing session)
// and no exchange error occurred
const showResetForm = user && !tokenExchangeError;

// Show error if we had a code but exchange failed, or if there's no code and no user
const showError = (code && tokenExchangeError) || (!code && !user);
---

<AuthLayout title="Reset Password - Voice Story">
  <div class="w-full max-w-md">
    {
      showResetForm ? (
        <ResetPasswordForm client:load />
      ) : showError ? (
        <Card className="w-full">
          <CardHeader>
            <CardTitle className="text-xl sm:text-2xl">Invalid reset link</CardTitle>
            <CardDescription className="text-sm">This password reset link is not valid</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-4">
              <div
                role="alert"
                class="rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive"
              >
                <p class="font-medium">This reset link is no longer valid. Request a new one.</p>
                <p class="mt-1 text-destructive/80">
                  Password reset links expire after a certain time for security reasons.
                </p>
                {errorMessage && <p class="mt-2 text-xs font-mono text-destructive/70">Error: {errorMessage}</p>}
              </div>
              <a
                href="/auth/forgot-password"
                class="inline-flex h-9 w-full items-center justify-center rounded-md border border-input bg-background px-4 text-sm font-medium shadow-xs transition hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                Request new reset link
              </a>
            </div>
          </CardContent>
        </Card>
      ) : (
        <Card className="w-full">
          <CardHeader>
            <CardTitle className="text-xl sm:text-2xl">Loading...</CardTitle>
            <CardDescription className="text-sm">Verifying your reset link</CardDescription>
          </CardHeader>
        </Card>
      )
    }
  </div>
</AuthLayout>
