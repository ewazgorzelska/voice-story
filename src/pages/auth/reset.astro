---
import AuthLayout from "@/layouts/AuthLayout.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "@/components/ui/card";

// Extract token from URL query parameters
const url = new URL(Astro.request.url);
const token = url.searchParams.get("token");
const type = url.searchParams.get("type");

// Validate that we have a recovery token
const isValidResetLink = type === "recovery" && token;

// Note: In the future, this page will also check for existing session
// and redirect authenticated users to /library
---

<AuthLayout title="Reset Password - Voice Story">
  <div class="w-full max-w-md">
    {
      isValidResetLink && token ? (
        <ResetPasswordForm token={token} client:load />
      ) : (
        <Card className="w-full">
          <CardHeader>
            <CardTitle className="text-xl sm:text-2xl">Invalid reset link</CardTitle>
            <CardDescription className="text-sm">This password reset link is not valid</CardDescription>
          </CardHeader>
          <CardContent>
            <div class="space-y-4">
              <div
                role="alert"
                class="rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive"
              >
                <p class="font-medium">This reset link is no longer valid. Request a new one.</p>
                <p class="mt-1 text-destructive/80">
                  Password reset links expire after a certain time for security reasons.
                </p>
              </div>
              <a
                href="/auth/forgot-password"
                class="inline-flex h-9 w-full items-center justify-center rounded-md border border-input bg-background px-4 text-sm font-medium shadow-xs transition hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
              >
                Request new reset link
              </a>
            </div>
          </CardContent>
        </Card>
      )
    }
  </div>
</AuthLayout>
