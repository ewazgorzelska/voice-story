---
import "../styles/global.css";
import NavBar from "@/components/NavBar.astro";

interface Props {
  title?: string;
  hideNav?: boolean;
}

const { title = "10x Astro Starter", hideNav = false } = Astro.props;
const user = Astro.locals.user ?? null;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {hideNav ? null : <NavBar currentPath={currentPath} user={user} />}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
